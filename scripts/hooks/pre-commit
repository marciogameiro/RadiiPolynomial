#!/bin/sh
# Refuse a commit that breaks the layer structure (see scripts/check_layers.py).
# Installed with:  git config core.hooksPath scripts/hooks
cd "$(git rev-parse --show-toplevel)" || exit 1
if ! python3 scripts/check_layers.py; then
  echo "pre-commit: layer check failed; fix the imports above (or commit with --no-verify)." >&2
  exit 1
fi
